<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <intent><action android:name="com.samsung.accessibility.installed_service" /></intent>
        <package android:name="com.samsung.rms.retailagent.global"/>
        <package android:name="com.android.settings"/>
        <!-- Visibility of exact stock packages for post-provisioning audit.
             No QUERY_ALL_PACKAGES; no unknown packages are modified. -->
        <package android:name="com.samsung.android.app.omcagent"/>
        <package android:name="com.sec.android.app.samsungapps"/>
        <package android:name="com.sec.android.app.SecSetupWizard"/>
        <package android:name="com.google.android.setupwizard"/>
        <package android:name="com.android.vending"/>
        <package android:name="com.google.android.gms"/>
        <package android:name="com.google.android.googlequicksearchbox"/>
        <package android:name="com.android.chrome"/>
        <package android:name="com.google.android.youtube"/>
        <package android:name="com.google.android.apps.maps"/>
        <package android:name="com.google.android.gm"/>
        <package android:name="com.google.android.apps.photos"/>
        <package android:name="com.google.android.webview"/>
        <package android:name="com.samsung.android.calendar"/>
        <package android:name="com.sec.android.app.popupcalculator"/>
        <package android:name="com.sec.android.app.clockpackage"/>
        <package android:name="com.samsung.android.app.notes"/>
        <package android:name="com.samsung.android.voc"/>
        <package android:name="com.samsung.android.bixby.agent"/>
        <package android:name="com.samsung.android.app.tips"/>
        <package android:name="com.samsung.android.game.gamehome"/>
        <package android:name="com.samsung.sree"/>
        <package android:name="com.facebook.katana"/>
        <package android:name="com.instagram.android"/>
        <package android:name="com.spotify.music"/>
    </queries>
    <application android:allowBackup="false" android:label="Retail Setup"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false">
        <receiver android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin"/>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE"/>
            </intent-filter>
        </receiver>
        <activity android:name=".ProvisioningModeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:name=".PolicyComplianceActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <service android:name=".InstallJobService" android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".PostDemoAppsJobService" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".GooglePlayVersionJobService" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <receiver android:name=".PostDemoInstallReceiver" android:exported="false"/>
        <activity android:name=".PostDemoApprovalActivity" android:exported="false"/>
        <receiver android:name=".InstallResultReceiver" android:exported="false"/>
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/></intent-filter>
        </receiver>
        <service android:name=".demo.RetailAutomationService"
            android:label="Retail Setup — automatyzacja demo"
            android:description="@string/accessibility_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/retail_accessibility"/>
        </service>
        <!-- Android explicitly opens this after successful Device Owner provisioning. -->
        <!-- Dedicated task retains the visible ready START when temporary HOME
             preferences are cleared during Device Owner release. -->
        <activity android:name=".ReadyActivity" android:exported="false"
            android:taskAffinity="com.example.retaildpc.ready"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"/>
        <!-- ConsumerBaselineActivity is intentionally NOT exposed in the main
             Retail Setup package. A separate no-permissions test APK remains
             available for normal Samsung setup diagnostics. This prevents a
             persistent second launcher icon after Retail Mode confirmation. -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.PROVISIONING_SUCCESSFUL"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- AOSP PackageManager.getLaunchIntentForPackage searches INFO
                 before LAUNCHER; no launcher icon is required. Samsung's
                 Settings app may or may not show an Open button. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.INFO"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity-alias android:name=".HomeActivity" android:targetActivity=".MainActivity"
            android:exported="true" android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherActivity" android:targetActivity=".MainActivity"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
