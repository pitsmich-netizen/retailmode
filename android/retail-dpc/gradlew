#!/bin/sh
set -eu
APP_HOME=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
EXPECTED="81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f"
if [ ! -f "$WRAPPER_JAR" ]; then
  command -v curl >/dev/null 2>&1 || { echo 'Potrzebny curl.' >&2; exit 1; }
  curl -fL --retry 2 -o "$WRAPPER_JAR.tmp" 'https://raw.githubusercontent.com/gradle/gradle/v8.13.0/gradle/wrapper/gradle-wrapper.jar'
  ACTUAL=$(sha256sum "$WRAPPER_JAR.tmp" | cut -d' ' -f1)
  [ "$ACTUAL" = "$EXPECTED" ] || { rm -f "$WRAPPER_JAR.tmp"; echo 'Blad SHA-256 wrapper JAR' >&2; exit 1; }
  mv "$WRAPPER_JAR.tmp" "$WRAPPER_JAR"
fi
if [ -n "${JAVA_HOME:-}" ]; then JAVA_EXE="$JAVA_HOME/bin/java"; else JAVA_EXE='java'; fi
exec "$JAVA_EXE" -Dorg.gradle.appname=gradlew -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
